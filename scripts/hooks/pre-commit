#!/bin/bash
#
# Pre-commit hook for Vendor MDM Portal
# Enforces Brain Rules Section 8 (Pre-Commit Verification Protocol)
#
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#

set -e

echo "═══════════════════════════════════════════════════════════"
echo "🔍 PRE-COMMIT VERIFICATION (Brain Rules Section 8)"
echo "═══════════════════════════════════════════════════════════"

ERRORS=0

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# 1. Check for conflict markers (exclude scripts/hooks and workflow files that contain grep patterns)
echo ""
echo "Checking for conflict markers..."
CONFLICT_FILES=$(git diff --cached --name-only | grep -v "scripts/hooks\|\.yml$\|\.yaml$\|\.md$" | xargs grep -l "^<<<<<<\|^>>>>>>\|^======" 2>/dev/null || true)
if [ -n "$CONFLICT_FILES" ]; then
    echo "$CONFLICT_FILES"
    echo -e "${RED}✗ Found conflict markers in staged files${NC}"
    ((ERRORS++))
else
    echo -e "${GREEN}✓ No conflict markers${NC}"
fi

# 2. Check for large migrations (if any .cs files in Migrations are staged)
STAGED_MIGRATIONS=$(git diff --cached --name-only | grep "Migrations/.*\.cs$" | grep -v "Designer\|Snapshot" || true)
if [ -n "$STAGED_MIGRATIONS" ]; then
    echo ""
    echo "Checking migration file sizes..."
    for file in $STAGED_MIGRATIONS; do
        if [ -f "$file" ]; then
            SIZE=$(wc -c < "$file")
            if [ $SIZE -gt 51200 ]; then  # 50KB
                echo -e "${RED}✗ Migration $file is too large ($(($SIZE/1024))KB > 50KB)${NC}"
                echo "  Split the migration per Brain Rules Section 8.2"
                ((ERRORS++))
            fi
        fi
    done
    [ $ERRORS -eq 0 ] && echo -e "${GREEN}✓ All migrations under 50KB${NC}"
fi

# 3. Check for hardcoded secrets patterns
echo ""
echo "Checking for potential secrets..."
SECRETS_PATTERNS='password\s*=\s*["\x27][^\x27"]+["\x27]|api[_-]?key\s*=\s*["\x27][^\x27"]+["\x27]|secret\s*=\s*["\x27][^\x27"]+["\x27]'
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cs|ts|tsx|json)$' || true)
if [ -n "$STAGED_FILES" ]; then
    for file in $STAGED_FILES; do
        if [ -f "$file" ] && grep -iE "$SECRETS_PATTERNS" "$file" 2>/dev/null | grep -v "appsettings\|\.example\|test\|mock" >/dev/null; then
            echo -e "${YELLOW}⚠ Potential secret in: $file${NC}"
            echo "  Review this file for hardcoded credentials"
        fi
    done
fi
echo -e "${GREEN}✓ Secret patterns check complete${NC}"

# 4. ESLint check for frontend changes (TypeScript type-check handled by CI)
FRONTEND_CHANGED=$(git diff --cached --name-only | grep "^frontend/.*\.\(ts\|tsx\)$" || true)
if [ -n "$FRONTEND_CHANGED" ]; then
    echo ""
    echo "Frontend changes detected - running ESLint check..."
    if [ -d "frontend/node_modules" ]; then
        cd frontend
        # Run ESLint only on changed files (faster than full tsc)
        if npx eslint --max-warnings 0 $FRONTEND_CHANGED > /dev/null 2>&1; then
            echo -e "${GREEN}✓ ESLint passed${NC}"
        else
            echo -e "${YELLOW}⚠ ESLint warnings (see 'npm run lint' for details)${NC}"
            # Don't fail on ESLint warnings - CI will catch strict issues
        fi
        cd ..
    else
        echo -e "${YELLOW}⚠ Skipping lint (run 'npm install' in frontend)${NC}"
    fi
fi

# 5. Backend build check for .cs changes
BACKEND_CHANGED=$(git diff --cached --name-only | grep "^backend/.*\.cs$" || true)
if [ -n "$BACKEND_CHANGED" ]; then
    echo ""
    echo "Backend changes detected - running build check..."
    if dotnet build backend/VendorMdm.Api/VendorMdm.Api.csproj --configuration Release --nologo -v q 2>/dev/null; then
        echo -e "${GREEN}✓ Backend builds successfully${NC}"
    else
        echo -e "${RED}✗ Backend build failed${NC}"
        echo "  Run 'dotnet build backend/VendorMdm.Api/VendorMdm.Api.csproj' to see errors"
        ((ERRORS++))
    fi
fi

# Summary
echo ""
echo "═══════════════════════════════════════════════════════════"
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}✗ PRE-COMMIT FAILED: $ERRORS error(s)${NC}"
    echo "Fix the issues above or use 'git commit --no-verify' to skip (NOT recommended)"
    exit 1
else
    echo -e "${GREEN}✓ PRE-COMMIT PASSED${NC}"
fi
