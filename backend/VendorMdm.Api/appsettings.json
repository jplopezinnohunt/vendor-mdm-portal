{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "DataSourceMode": "Auto",
    "ConnectionStrings": {
        "Sql": "Server=tcp:sql-vendor-mdm-dev.database.windows.net,1433;Initial Catalog=VendorMdmDb;Authentication=Active Directory Managed Identity;Encrypt=True;TrustServerCertificate=False;",
        "Cosmos": "https://cosmos-vendor-mdm-dev.documents.azure.com:443/",
        "ServiceBus": "sb-vendor-mdm-dev.servicebus.windows.net"
    },
    "SapEnvironmentCode": "D01",
    "Services": {
        "Comment": "Each service can be toggled between Mock and Real implementation independently",
        "SAP": {
            "UseMock": true,
            "RealProvider": "SapNco",
            "MockSettings": {
                "SimulateLatency": false,
                "LatencyMs": 150,
                "MockVendorCount": 50
            },
            "RealSettings": {
                "Host": "sap-server.company.com",
                "SystemNumber": "00",
                "Client": "100",
                "Language": "EN"
            }
        },
        "RBAC": {
            "UseMock": true,
            "RealProvider": "AzureAd",
            "MockSettings": {
                "DefaultRole": "Requestor",
                "AdminUsers": [
                    "admin@test.com"
                ]
            },
            "RealSettings": {
                "TenantId": "your-tenant-id",
                "ClientId": "your-client-id"
            }
        },
        "MasterData": {
            "UseMock": true,
            "RealProvider": "Database",
            "MockSettings": {
                "CountryCount": 195,
                "CurrencyCount": 50
            }
        },
        "Workflow": {
            "UseMock": true,
            "RealProvider": "Database",
            "MockSettings": {
                "EnableSlaMonitoring": true
            }
        },
        "Email": {
            "UseMock": true,
            "RealProvider": "SendGrid",
            "MockSettings": {
                "LogToConsole": true
            },
            "RealSettings": {
                "ApiKey": "from-keyvault"
            }
        },
        "FileStorage": {
            "UseMock": true,
            "RealProvider": "AzureBlob",
            "MaxFileSizeBytes": 10485760,
            "AllowedExtensions": [
                ".pdf",
                ".jpg",
                ".jpeg",
                ".png",
                ".doc",
                ".docx"
            ],
            "MockSettings": {
                "TempPath": "/tmp/vendor-mdm-files"
            },
            "RealSettings": {
                "ContainerName": "vendor-documents"
            }
        }
    }
}