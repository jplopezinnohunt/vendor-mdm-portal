{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://platform.vendor.com/schemas/user/v1.0.0",
    "title": "User Canonical Entity",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "username",
        "email",
        "role"
    ],
    "properties": {
        "username": {
            "type": "string",
            "maxLength": 100
        },
        "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
        },
        "role": {
            "type": "string",
            "enum": [
                "Admin",
                "Requester",
                "Approver",
                "Viewer"
            ]
        },
        "fullName": {
            "type": "string",
            "maxLength": 200
        },
        "department": {
            "type": "string",
            "maxLength": 100
        },
        "uiPreferences": {
            "type": "object",
            "properties": {
                "theme": {
                    "type": "string",
                    "enum": [
                        "light",
                        "dark"
                    ]
                },
                "language": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 5
                }
            }
        },
        "notificationSettings": {
            "type": "object",
            "properties": {
                "emailEnabled": {
                    "type": "boolean"
                },
                "pushEnabled": {
                    "type": "boolean"
                }
            }
        }
    }
}