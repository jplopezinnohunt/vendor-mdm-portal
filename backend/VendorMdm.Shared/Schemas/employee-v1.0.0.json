{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.vendor.com/schemas/employee/v1.0.0",
  "title": "Employee Canonical Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["givenName", "surname", "email"],
  "properties": {
    "givenName": { "type": "string", "maxLength": 100 },
    "surname": { "type": "string", "maxLength": 100 },
    "email": { "type": "string", "format": "email", "maxLength": 255 },
    "employeeId": { "type": "string", "maxLength": 50 },
    "department": { "type": "string", "maxLength": 100 },
    "title": { "type": "string", "maxLength": 100 },
    "managerId": { "type": "string", "format": "uuid" },
    "isActive": { "type": "boolean", "default": true }
  }
}
