{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://platform.vendor.com/schemas/customer/v1.0.0",
    "title": "Customer Canonical Entity",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "type": "string",
            "maxLength": 200
        },
        "taxId": {
            "type": "string",
            "maxLength": 100
        },
        "primaryContactEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 255
        },
        "industry": {
            "type": "string",
            "maxLength": 100
        },
        "billingAddress": {
            "type": "object",
            "properties": {
                "street": {
                    "type": "string"
                },
                "city": {
                    "type": "string"
                },
                "zipCode": {
                    "type": "string"
                },
                "country": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                }
            }
        },
        "segment": {
            "type": "string",
            "enum": [
                "Enterprise",
                "SMB",
                "Government"
            ]
        }
    }
}