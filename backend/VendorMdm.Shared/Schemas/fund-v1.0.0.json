{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://platform.vendor.com/schemas/fund/v1.0.0",
    "title": "Fund Canonical Entity",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "fundCode",
        "name"
    ],
    "properties": {
        "fundCode": {
            "type": "string",
            "maxLength": 50
        },
        "name": {
            "type": "string",
            "maxLength": 200
        },
        "fiscalYear": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
        },
        "description": {
            "type": "string",
            "maxLength": 500
        },
        "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
        },
        "ownerDepartment": {
            "type": "string",
            "maxLength": 100
        }
    }
}