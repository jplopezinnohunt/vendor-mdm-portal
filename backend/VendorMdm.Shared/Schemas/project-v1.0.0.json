{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://platform.vendor.com/schemas/project/v1.0.0",
    "title": "Project Canonical Entity",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "projectCode",
        "name"
    ],
    "properties": {
        "projectCode": {
            "type": "string",
            "maxLength": 50
        },
        "name": {
            "type": "string",
            "maxLength": 200
        },
        "startDate": {
            "type": "string",
            "format": "date-time"
        },
        "endDate": {
            "type": "string",
            "format": "date-time"
        },
        "status": {
            "type": "string",
            "enum": [
                "Active",
                "Closed",
                "OnHold",
                "Draft"
            ]
        },
        "budget": {
            "type": "number"
        },
        "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
        },
        "managerId": {
            "type": "string",
            "format": "uuid"
        }
    }
}